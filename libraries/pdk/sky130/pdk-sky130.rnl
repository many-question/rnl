/* pdk-sky130 0.1, a PDK symbol package for the SkyWater SKY130 PDK (sky130_fd_pr).
   Generated by scripts/pdk/sky130.py; run `python scripts/pdk/sky130.py --check` to verify.

   Target PDK: SkyWater Open Source PDK (sky130_fd_pr, v0.2.0 / open_pdks sky130A/sky130B).
   Upstream PDK repository: https://github.com/google/skywater-pdk-libs-sky130_fd_pr
   Upstream PDK license: Apache-2.0 (Copyright 2020 The SkyWater PDK Authors).
   No PDK model parameters, equations, or subcircuit netlists are copied into this file;
   this package contains only RNL 0.3 terminal name declarations (@DEVICE), schematic
   symbols (@DEFINE-SYMBOL), and model-to-symbol selection rules (@SELECT-INSTANCE).

   Dialect coverage:
   - SPICE (.sp, .cir, .spice): subcircuit calls (`XM1 d g s b sky130_fd_pr__nfet_01v8 ...`)
     and native primitive elements (`D1`, `Q1`, `R1`, `C1`, `M1`) naming SKY130 models.
   - Spectre (.scs): subcircuit/model instances (`M1 (d g s b) sky130_fd_pr__nfet_01v8 ...`)
     whose instance names do not start with `X`.
   - Works both WITHOUT PDK model files included (terminal names come from @DEVICE in the
     header below) and WITH PDK `.subckt` / `subckt` definitions included (6.12). */
@RNL(type="header") {
  @VERSION("0.3");
  @PACKAGE(name="pdk-sky130", version="0.1");
  @USE-PACKAGE(name="rnl-std-basic", version="0.3");
  @USE-PACKAGE(name="rnl-std-semiconductors", version="0.3");

  /* -------------------------------------------------------------- terminal declarations (6.12) */
  /* NMOS (4-terminal): 1.8 V / 5.0 V / 10.5 V standard, LVT, ESD, special, and RF NMOS (d g s b) */
  @DEVICE(name="*", model="sky130_fd_pr__nfet_01v8", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__nfet_01v8_lvt", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__nfet_g5v0d10v5", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__esd_nfet_01v8", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__esd_nfet_g5v0d10v5", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__special_nfet_latch", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__special_nfet_latch_lowleakage", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__special_nfet_pass", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__special_nfet_pass_lowleakage", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__special_nfet_pass_lvt", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__special_nfet_pass_flash", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__rf_nfet_01v8*", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__rf_nfet_g5v0d10v5*", terminals=["d", "g", "s", "b"]);
  /* Native / Zero-Vt NMOS (4-terminal): 3.3 V / 5.0 V / 10.5 V / 20 V native-Vt and zero-Vt NMOS (d g s b) */
  @DEVICE(name="*", model="sky130_fd_pr__nfet_03v3_nvt", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__nfet_05v0_nvt", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__esd_nfet_05v0_nvt", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__esd_nfet_g5v0d10v5_nvt", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__nfet_20v0_nvt", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__nfet_20v0_zvt", terminals=["d", "g", "s", "b"]);
  /* Drain-Extended / 20 V NMOS (4-terminal): 16 V / 20 V drain-extended and high-voltage NMOS (d g s b) */
  @DEVICE(name="*", model="sky130_fd_pr__nfet_g5v0d16v0", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__nfet_20v0", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__nfet_extenddrain", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__esd_rf_nfet_20v0*", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__rf_nfet_20v0_aup", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__rf_nfet_20v0_nvt_aup", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__rf_nfet_20v0_withptap", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__rf_nfet_20v0_nvt_withptap", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__rf_nfet_20v0_zvt_withptap", terminals=["d", "g", "s", "b"]);
  /* Isolated 20 V NMOS (5-terminal): Isolated 20 V NMOS with separate substrate terminal (d g s b sub) */
  @DEVICE(name="*", model="sky130_fd_pr__nfet_20v0_iso", terminals=["d", "g", "s", "b", "sub"]);
  @DEVICE(name="*", model="sky130_fd_pr__nfet_20v0_nvt_iso", terminals=["d", "g", "s", "b", "sub"]);
  @DEVICE(name="*", model="sky130_fd_pr__nfet_20v0_reverse_iso", terminals=["d", "g", "s", "b", "sub"]);
  @DEVICE(name="*", model="sky130_fd_pr__rf_nfet_20v0_iso", terminals=["d", "g", "s", "b", "sub"]);
  @DEVICE(name="*", model="sky130_fd_pr__rf_nfet_20v0_nvt_iso", terminals=["d", "g", "s", "b", "sub"]);
  @DEVICE(name="*", model="sky130_fd_pr__rf_nfet_20v0_zvt_iso", terminals=["d", "g", "s", "b", "sub"]);
  /* PMOS (4-terminal): 1.8 V / 5.0 V / 10.5 V standard, LVT, MVT, HVT, ESD, special, and RF PMOS (d g s b) */
  @DEVICE(name="*", model="sky130_fd_pr__pfet_01v8", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__pfet_01v8_lvt", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__pfet_01v8_mvt", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__pfet_01v8_hvt", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__pfet_g5v0d10v5", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__esd_pfet_g5v0d10v5", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__special_pfet_pass", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__special_pfet_pass_lowleakage", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__rf_pfet_01v8*", terminals=["d", "g", "s", "b"]);
  /* Drain-Extended / 20 V PMOS (4-terminal): 16 V / 20 V drain-extended and high-voltage PMOS (d g s b) */
  @DEVICE(name="*", model="sky130_fd_pr__pfet_g5v0d16v0", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__pfet_20v0", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__pfet_extenddrain", terminals=["d", "g", "s", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__rf_pfet_20v0*", terminals=["d", "g", "s", "b"]);
  /* NPN BJT (4-terminal): 5.5 V and 11.0 V vertical NPN bipolar transistors with substrate port (c b e s) */
  @DEVICE(name="*", model="sky130_fd_pr__npn_05v5_W1p00L1p00", terminals=["c", "b", "e", "s"]);
  @DEVICE(name="*", model="sky130_fd_pr__npn_05v5_W1p00L2p00", terminals=["c", "b", "e", "s"]);
  @DEVICE(name="*", model="sky130_fd_pr__npn_11v0_W1p00L1p00", terminals=["c", "b", "e", "s"]);
  @DEVICE(name="*", model="sky130_fd_pr__npn_*", terminals=["c", "b", "e", "s"]);
  @DEVICE(name="*", model="sky130_fd_pr__rf_npn_*", terminals=["c", "b", "e", "s"]);
  /* PNP BJT (4-terminal): 5.5 V vertical substrate PNP bipolar transistors with substrate port (c b e s) */
  @DEVICE(name="*", model="sky130_fd_pr__pnp_05v5_W0p68L0p68", terminals=["c", "b", "e", "s"]);
  @DEVICE(name="*", model="sky130_fd_pr__pnp_05v5_W3p40L3p40", terminals=["c", "b", "e", "s"]);
  @DEVICE(name="*", model="sky130_fd_pr__pnp_*", terminals=["c", "b", "e", "s"]);
  @DEVICE(name="*", model="sky130_fd_pr__rf_pnp_*", terminals=["c", "b", "e", "s"]);
  /* Poly & Well Resistors (3-terminal, r0 r1 b): High-sheet-rho and extra-high-sheet-rho precision poly resistors and isolated P-well resistors (r0 r1 b) */
  @DEVICE(name="*", model="sky130_fd_pr__res_high_po", terminals=["r0", "r1", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__res_high_po_0p35", terminals=["r0", "r1", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__res_high_po_0p69", terminals=["r0", "r1", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__res_high_po_1p41", terminals=["r0", "r1", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__res_high_po_2p85", terminals=["r0", "r1", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__res_high_po_5p73", terminals=["r0", "r1", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__res_xhigh_po_0p35", terminals=["r0", "r1", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__res_xhigh_po_0p69", terminals=["r0", "r1", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__res_xhigh_po_1p41", terminals=["r0", "r1", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__res_xhigh_po_2p85", terminals=["r0", "r1", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__res_xhigh_po_5p73", terminals=["r0", "r1", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__res_iso_pw", terminals=["r0", "r1", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__res_generic_pw", terminals=["r0", "r1", "b"]);
  /* Extra-High Poly Resistor (3-terminal, r0 r1 sub): Variable-width extra-high-sheet-rho poly resistor (r0 r1 sub) */
  @DEVICE(name="*", model="sky130_fd_pr__res_xhigh_po", terminals=["r0", "r1", "sub"]);
  /* Base Extra-High Poly Resistor (3-terminal, r1 r2 b): Base subcircuit for extra-high-sheet-rho poly resistor (r1 r2 b) */
  @DEVICE(name="*", model="sky130_fd_pr__res_xhigh_po__base", terminals=["r1", "r2", "b"]);
  /* Diffusion Resistors (3-terminal, t1 t2 b): N+ and P+ diffusion resistors (1.8 V and 5.5 V HV) with bulk terminal (t1 t2 b) */
  @DEVICE(name="*", model="sky130_fd_pr__res_generic_nd", terminals=["t1", "t2", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__res_generic_nd__hv", terminals=["t1", "t2", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__res_generic_pd", terminals=["t1", "t2", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__res_generic_pd__hv", terminals=["t1", "t2", "b"]);
  /* Poly & Metal Interconnect Resistors (2-terminal, r0 r1): 2-terminal generic poly, N-well, local interconnect, and metal (M1-M5, RDL) resistors (r0 r1) */
  @DEVICE(name="*", model="sky130_fd_pr__res_generic_po", terminals=["r0", "r1"]);
  @DEVICE(name="*", model="sky130_fd_pr__res_generic_nw", terminals=["r0", "r1"]);
  @DEVICE(name="*", model="sky130_fd_pr__res_generic_l1", terminals=["r0", "r1"]);
  @DEVICE(name="*", model="sky130_fd_pr__res_generic_m1", terminals=["r0", "r1"]);
  @DEVICE(name="*", model="sky130_fd_pr__res_generic_m2", terminals=["r0", "r1"]);
  @DEVICE(name="*", model="sky130_fd_pr__res_generic_m3", terminals=["r0", "r1"]);
  @DEVICE(name="*", model="sky130_fd_pr__res_generic_m4", terminals=["r0", "r1"]);
  @DEVICE(name="*", model="sky130_fd_pr__res_generic_m5", terminals=["r0", "r1"]);
  @DEVICE(name="*", model="sky130_fd_pr__res_generic_r1", terminals=["r0", "r1"]);
  @DEVICE(name="*", model="sky130_fd_pr__model__parasitic__res_po", terminals=["r0", "r1"]);
  /* MIM Capacitors (2-terminal, c0 c1): Metal-insulator-metal capacitors on M3/M4 and M4/M5 (c0 c1) */
  @DEVICE(name="*", model="sky130_fd_pr__cap_mim_m3_1", terminals=["c0", "c1"]);
  @DEVICE(name="*", model="sky130_fd_pr__cap_mim_m3_2", terminals=["c0", "c1"]);
  @DEVICE(name="*", model="sky130_fd_pr__cap_mim_m3*", terminals=["c0", "c1"]);
  @DEVICE(name="*", model="sky130_fd_pr__cap_mim_m4*", terminals=["c0", "c1"]);
  /* MOS Varactors (3-terminal, c0 c1 b): LVT and HVT accumulation-mode MOS varactors (c0 c1 b) */
  @DEVICE(name="*", model="sky130_fd_pr__cap_var_lvt", terminals=["c0", "c1", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__cap_var_hvt", terminals=["c0", "c1", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__cap_var", terminals=["c0", "c1", "b"]);
  @DEVICE(name="*", model="sky130_fd_pr__cap_var_*", terminals=["c0", "c1", "b"]);
  /* VPP Capacitors (3-terminal, c0 c1 b): Vertical parallel-plate (VPP) capacitors with substrate terminal (c0 c1 b) */
  @DEVICE(name="*", model="sky130_fd_pr__cap_vpp_*", terminals=["c0", "c1", "b"]);
  /* Shielded VPP Capacitors (4-terminal, c0 c1 b m5/m4/m3): Vertical parallel-plate (VPP) capacitors with top metal shield terminal (c0 c1 b m5/m4/m3) */
  @DEVICE(name="*", model="sky130_fd_pr__cap_vpp_*_shield*m5*", terminals=["c0", "c1", "b", "m5"]);
  @DEVICE(name="*", model="sky130_fd_pr__cap_vpp_*_shield*m4*", terminals=["c0", "c1", "b", "m5"]);
  @DEVICE(name="*", model="sky130_fd_pr__cap_vpp_*_shield*m3*", terminals=["c0", "c1", "b", "m5"]);
  /* Diodes (2-terminal, a k): P-well to N+ and P+ to N-well junction, ESD, and parasitic diodes (a k) */
  @DEVICE(name="*", model="sky130_fd_pr__diode_pw2nd_05v5", terminals=["a", "k"]);
  @DEVICE(name="*", model="sky130_fd_pr__diode_pw2nd_05v5_lvt", terminals=["a", "k"]);
  @DEVICE(name="*", model="sky130_fd_pr__diode_pw2nd_05v5_nvt", terminals=["a", "k"]);
  @DEVICE(name="*", model="sky130_fd_pr__diode_pw2nd_11v0", terminals=["a", "k"]);
  @DEVICE(name="*", model="sky130_fd_pr__diode_pd2nw_05v5", terminals=["a", "k"]);
  @DEVICE(name="*", model="sky130_fd_pr__diode_pd2nw_05v5_lvt", terminals=["a", "k"]);
  @DEVICE(name="*", model="sky130_fd_pr__diode_pd2nw_05v5_hvt", terminals=["a", "k"]);
  @DEVICE(name="*", model="sky130_fd_pr__diode_pd2nw_11v0", terminals=["a", "k"]);
  @DEVICE(name="*", model="sky130_fd_pr__diode_*", terminals=["a", "k"]);
  @DEVICE(name="*", model="sky130_fd_pr__esd_rf_diode_*", terminals=["a", "k"]);
  @DEVICE(name="*", model="sky130_fd_pr__model__parasitic__diode_*", terminals=["a", "k"]);
  @DEVICE(name="*", model="sky130_fd_pr__model__parasitic__rf_diode_*", terminals=["a", "k"]);
  /* RF Spiral Inductors (4-terminal, a b ct sub): Center-tapped RF spiral inductors with substrate terminal (a b ct sub) */
  @DEVICE(name="*", model="sky130_fd_pr__ind_03_90", terminals=["a", "b", "ct", "sub"]);
  @DEVICE(name="*", model="sky130_fd_pr__ind_05_125", terminals=["a", "b", "ct", "sub"]);
  @DEVICE(name="*", model="sky130_fd_pr__ind_05_220", terminals=["a", "b", "ct", "sub"]);
  @DEVICE(name="*", model="sky130_fd_pr__ind_*", terminals=["a", "b", "ct", "sub"])
}

/* ---------------------------------------------------------------- SKY130 multi-terminal symbols (9.2)
   Standard 0.3 provides 2-terminal passives ($RESISTOR, $CAPACITOR, $INDUCTOR, $DIODE),
   3-terminal BJTs ($NPN, $PNP), and 4-terminal MOSFETs ($NMOS_4TERM, $PMOS_4TERM,
   $DEPLETION_NMOS_4TERM, $NDMOS_4TERM, $PDMOS_4TERM). In sky130_fd_pr, precision poly
   and diffusion resistors have 3 terminals (with bulk/substrate), MOS varactors and VPP
   capacitors have 3 or 4 terminals, vertical BJTs are 4-terminal subcircuits (c b e s),
   isolated 20 V NMOS devices have 5 terminals (d g s b sub), and RF spiral inductors
   have 4 terminals (a b ct sub). All pins sit on integer grid points (9.2.4). */
@RNL {
  /* r0 r1 b (or r0 r1 sub, r1 r2 b, t1 t2 b) = 1 2 3; 3-terminal resistor with substrate/bulk pin */
  $SKY130_RESISTOR_3TERM = @DEFINE-SYMBOL(box=[-2, -2, 1, 2]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    (-2, 0) @PIN(terminal=3, direction="left");
    @LINE {(0, 2) (0, 0.8721) (0.5372, 0.6395) (-0.4605, 0.407) (0.5372, 0.1163) (-0.4988, -0.1744) (0.5372, -0.4651) (-0.4605, -0.7558) (0, -0.8721) (0, -2)};
    @LINE {(-2, 0) (-0.85, 0)};
    @LINE {(-0.85, -0.85) (-0.85, 0.85)};
    ? @TEXT("${name}", key="name") => @PLACE(0.95, 0.25);
    ? @TEXT("${model}", key="value") => @PLACE(0.95, -0.95)
  };

  /* c0 c1 b = 1 2 3; 3-terminal capacitor (VPP / MOS cap) with substrate/bulk pin */
  $SKY130_CAPACITOR_3TERM = @DEFINE-SYMBOL(box=[-2, -2, 1.2, 2]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    (-2, 0) @PIN(terminal=3, direction="left");
    @LINE(linewidth=0.24) {(0.8051, 0.3234) (-0.8051, 0.3234)};
    @LINE(linewidth=0.24) {(0.8051, -0.3234) (-0.8051, -0.3234)};
    @LINE {(0, 0.3234) (0, 2)};
    @LINE {(0, -0.3234) (0, -2)};
    @LINE {(-2, 0) (-1.2, 0)};
    @LINE {(-1.2, -0.8) (-1.2, 0.8)};
    ? @TEXT("${name}", key="name") => @PLACE(1.2, 0.25);
    ? @TEXT("${model}", key="value") => @PLACE(1.2, -0.95)
  };

  /* c0 c1 b shield = 1 2 3 4; 4-terminal shielded VPP capacitor */
  $SKY130_CAPACITOR_4TERM = @DEFINE-SYMBOL(box=[-2, -2, 2, 2]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    (-2, 0) @PIN(terminal=3, direction="left");
    (2, 0) @PIN(terminal=4, direction="right");
    @LINE(linewidth=0.24) {(0.8051, 0.3234) (-0.8051, 0.3234)};
    @LINE(linewidth=0.24) {(0.8051, -0.3234) (-0.8051, -0.3234)};
    @LINE {(0, 0.3234) (0, 2)};
    @LINE {(0, -0.3234) (0, -2)};
    @LINE {(-2, 0) (-1.2, 0)};
    @LINE {(-1.2, -0.8) (-1.2, 0.8)};
    @LINE {(1.2, 0) (2, 0)};
    @LINE {(1.2, -0.8) (1.2, 0.8)};
    ? @TEXT("${name}", key="name") => @PLACE(1.4, 0.85);
    ? @TEXT("${model}", key="value") => @PLACE(1.4, -1.25)
  };

  /* c0 c1 b = 1 2 3; 3-terminal MOS varactor with bulk pin */
  $SKY130_VARACTOR_3TERM = @DEFINE-SYMBOL(box=[-2, -2, 1.6, 2]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    (-2, 0) @PIN(terminal=3, direction="left");
    @LINE(linewidth=0.24) {(0.8051, 0.3234) (-0.8051, 0.3234)};
    @LINE(linewidth=0.24) {(0.8051, -0.3234) (-0.8051, -0.3234)};
    @LINE {(0, 0.3234) (0, 2)};
    @LINE {(0, -0.3234) (0, -2)};
    @LINE {(-1.2, -1.2) (0.9, 0.9)};
    @LINE(fill="linecolor", linestyle="none") {(1.2, 1.2) (0.6, 1) (1, 0.6) (1.2, 1.2)};
    @LINE {(-2, 0) (-1.35, 0)};
    @LINE {(-1.35, -0.8) (-1.35, 0.8)};
    ? @TEXT("${name}", key="name") => @PLACE(1.6, 0.25);
    ? @TEXT("${model}", key="value") => @PLACE(1.6, -0.95)
  };

  /* c b e s = 1 2 3 4; 4-terminal NPN BJT with substrate pin at (1, 0) */
  $SKY130_NPN_4TERM = @DEFINE-SYMBOL(box=[-3, -2, 1, 2]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (-3, 0) @PIN(terminal=2, direction="left");
    (0, -2) @PIN(terminal=3, direction="down");
    (1, 0) @PIN(terminal=4, direction="right");
    @LINE {(-3, 0) (-1.6869, 0)};
    @LINE(linewidth=0.24) {(-1.6869, 1.3346) (-1.6869, -1.333)};
    @LINE {(-1.6869, 0.6402) (0, 1.338) (0, 2)};
    @LINE {(-1.6869, -0.6404) (-0.7301, -1.0359)};
    @LINE {(-0.0936, -1.2991) (0, -1.3378) (0, -2)};
    @LINE(fill="linecolor", linestyle="none") {(-0.6635, -0.6792) (-0.9953, -1.3378) (0, -1.3378) (-0.6635, -0.6792)};
    @LINE {(0, -0.45) (0, 0.45)};
    @LINE {(0, 0) (1, 0)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 1.05);
    ? @TEXT("${model}", key="model") => @PLACE(0.5, -1.75)
  };

  /* c b e s = 1 2 3 4; 4-terminal PNP BJT with substrate pin at (1, 0) */
  $SKY130_PNP_4TERM = @DEFINE-SYMBOL(box=[-3, -2, 1, 2]) {
    (0, -2) @PIN(terminal=1, direction="down");
    (-3, 0) @PIN(terminal=2, direction="left");
    (0, 2) @PIN(terminal=3, direction="up");
    (1, 0) @PIN(terminal=4, direction="right");
    @LINE {(-3, 0) (-1.6869, 0)};
    @LINE(linewidth=0.24) {(-1.6869, 1.3334) (-1.6869, -1.3342)};
    @LINE {(-0.8575, 0.9694) (0, 1.338) (0, 2)};
    @LINE {(-1.6869, -0.6402) (0, -1.3378) (0, -2)};
    @LINE(fill="linecolor", linestyle="none") {(-1.0234, 1.2987) (-0.6916, 0.6402) (-1.6869, 0.6402) (-1.0234, 1.2987)};
    @LINE {(0, -0.45) (0, 0.45)};
    @LINE {(0, 0) (1, 0)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 1.05);
    ? @TEXT("${model}", key="model") => @PLACE(0.5, -1.75)
  };

  /* d g s b sub = 1 2 3 4 5; 5-terminal isolated 20 V drain-extended NMOS */
  $SKY130_NMOS_5TERM = @DEFINE-SYMBOL(box=[-3, -2, 1, 2]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (-3, 0) @PIN(terminal=2, direction="left");
    (0, -2) @PIN(terminal=3, direction="down");
    (1, 0) @PIN(terminal=4, direction="right");
    (1, -1) @PIN(terminal=5, direction="right");
    @LINE {(-1.4244, 0.6977) (0, 0.6977) (0, 2)};
    @LINE {(-1.4244, -0.6977) (0, -0.6977) (0, -2)};
    @LINE(fill="linecolor", linestyle="none") {(-2.1802, 0.9593) (-2.1802, -0.9593) (-1.8895, -0.9593) (-1.8895, 0.9593) (-2.1802, 0.9593)};
    @LINE(fill="linecolor", linestyle="none") {(-1.657, 1.25) (-1.657, -1.25) (-1.3663, -1.25) (-1.3663, 1.25) (-1.657, 1.25)};
    @LINE {(-2.0349, 0) (-3, 0)};
    @LINE {(-1.5116, 0) (0, 0)};
    @LINE {(0.6395, 0) (1, 0)};
    @LINE(fill="linecolor", linestyle="none") {(0, 0) (0.6395, 0.3488) (0.6395, -0.3488) (0, 0)};
    @LINE {(-1.4244, 0.2977) (0, 0.2977) (0, 0.6977)};
    @LINE {(0.35, -1.3) (0.35, -0.7)};
    @LINE {(0.35, -1) (1, -1)};
    ? @TEXT("${name}", key="name") => @PLACE(0.5, 1.05);
    ? @TEXT("${model}", key="model") => @PLACE(0.5, -1.75)
  };

  /* a b ct sub = 1 2 3 4; 4-terminal center-tapped RF spiral inductor */
  $SKY130_INDUCTOR_4TERM = @DEFINE-SYMBOL(box=[-1, -2, 1, 2]) {
    (0, 2) @PIN(terminal=1, direction="up");
    (0, -2) @PIN(terminal=2, direction="down");
    (-1, 0) @PIN(terminal=3, direction="left");
    (-1, -1) @PIN(terminal=4, direction="left");
    @LINE {(0, 2) (0, 1.2)};
    @ARC(cap="round") {(0, 1.2) (0.2121, 1.1121) (0.3, 0.9)};
    @ARC {(0.3, 0.9) (0.2121, 0.6879) (0, 0.6)};
    @ARC {(0, 0.6) (0.3, 0.3) (0, 0)};
    @ARC {(0, 0) (0.3, -0.3) (0, -0.6)};
    @ARC {(0.3, -0.6) (0.2121, -0.6879) (0.3, -0.9)};
    @ARC(cap="round") {(0.3, -0.9) (0.2121, -1.1121) (0, -1.2)};
    @LINE {(0, -1.2) (0, -2)};
    @LINE {(-1, 0) (0, 0)};
    @LINE {(-1, -1) (-0.4, -1)};
    @LINE {(-0.4, -1.3) (-0.4, -0.7)};
    ? @TEXT("${name}", key="name") => @PLACE(0.7, 0.25);
    ? @TEXT("${model}", key="value") => @PLACE(0.7, -0.95)
  }
}

/* ---------------------------------------------------------------- model-to-symbol rules (10.1)
   Broad wildcard patterns come before narrow overrides (such as 4-terminal shielded VPP
   capacitors overriding 3-terminal VPP capacitors). For 2-terminal passives that reuse
   $RESISTOR or $CAPACITOR from rnl-std-basic, key="value" defaults to `${model}` so
   subcircuit calls show their SKY130 model when no explicit value label is set. */
@RNL {
  /* NMOS (4-terminal) */
  # @SELECT-INSTANCE(model="sky130_fd_pr__nfet_01v8") => @SET-SYMBOL $NMOS_4TERM;
